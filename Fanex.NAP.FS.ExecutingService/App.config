<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="quartz" type="System.Configuration.NameValueFileSectionHandler" />
  </configSections>
  <quartz>
    <add key="quartz.plugin.quartzmin.type" value="Quartzmin.SelfHost.QuartzminPlugin, Quartzmin.SelfHost" />
    <add key="quartz.plugin.quartzmin.url" value="http://localhost:5000" />
    <add key="quartz.plugin.recentHistory.type" value="Quartz.Plugins.RecentHistory.ExecutionHistoryPlugin, Quartz.Plugins.RecentHistory" />
    <add key="quartz.plugin.recentHistory.storeType" value="Quartz.Plugins.RecentHistory.Impl.InProcExecutionHistoryStore, Quartz.Plugins.RecentHistory" />
  </quartz>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
  <appSettings>
    <add key="Environment" value="1" />
    <add key="AppData-Path" value="~/App_Data/NAPFSNames.xml" />
    
    <!-- RabbitMQ -->
    <add key="Queue-Host" value="ha.nexdev.net" />
    <add key="Queue-Port" value="5672" />
    <add key="Queue-VirtualHost" value="/FPS_Oneye_Service" />
    <add key="Queue-UserName" value="fps" />
    <add key="Queue-Password" value="fps" />
    <add key="Queue-PrefetchCount" value="1" />
    <add key="Queue-Exchange" value="FraudCaseExchange" />
    <add key="Log-SentryLogging-Config" value="https://95587e38aa44413094c39b488d4f8425@sentry.nexdev.net/33" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />

    <add key="FPS-WebAPI-Get-CustomerEvidence" value="http://ha.nexdev.net:7704/FPSMiddleService/GetCustomerEvidence" />
    
    <add key="ONEbook.UM:ServiceUri" value="http://ha.nexdev.net:8889/api" />
    <add key="ONEbook.UM:EnableCheckUM" value="true" />
    <add key="ONEbook.UM:SiteId" value="2000000" />
    <add key="ONEbook.UM:EnableUnscheduledUM" value="false" />
    <add key="ONEbook.UM:UMFrom" value="3:00" />
    <add key="ONEbook.UM:UMTo" value="4:00" />
    <add key="ONEbook.UM:UMPageUrl" value="/UserLogin/Common/Offline" />
    <add key="ONEbook.UM:ResultCacheDuration" value="60" />
    <add key="ONEbook.UM:UMLoggingCategory" value="ONEbook-UM" />
    <add key="ONEbook.UM:ErrorUMPageUrl" value="" />
    
  </appSettings>
  <connectionStrings>
    <add name="DBFS.bodb_FraudSensor.bodbSPUNet" connectionString="Data Source=10.18.200.215;Initial Catalog=bodb_FraudSensor;User Id=bodbSPUNet;Password=zh6D8zv6dhVnQfTYBlMJQD4DdnyeLRzDEkBb00oWvZM=" providerName="System.Data.SqlClient" />
  </connectionStrings>  
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-11.0.0.0" newVersion="11.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Owin" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.1.0.0" newVersion="2.1.0.0" />
      </dependentAssembly>     
    </assemblyBinding>
  </runtime> 
</configuration>