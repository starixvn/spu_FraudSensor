<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="Fanex.MailDelivery.Client" type="Fanex.MailDelivery.Client.Configurations.MailClientSection, Fanex.MailDelivery.Client" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
  </startup>
  <Fanex.Logging msmqPath="FormatName:DIRECT=TCP:10.35.35.254\private$\entlib" defaultCategory="SPU.Local" />

  <appSettings>
    <add key="ClientSettingsProvider.ServiceUri" value="" />
    <add key="queuePath" value="FormatName:DIRECT=TCP:10.70.70.242\private$\fdmessagequeue" />
    <add key="RemoteRefURL" value="tcp://ha.nexdev.net:8888/CallGetRefFunction" />
    <add key="MailingListId" value="80" />
    <add key="ExpiredTime" value="900" />
    <add key="Environment" value="1" />
    <!--1: LOCAL/TEST, 2: UAT, 3: PRO-->
    <add key="FPS_WEBAPI" value="http://ha.nexdev.net:7704/api/associatedaccountfraudsensor" />
    <add key="FPS_WEBAPI_GET_CUSTOMER_EVIDENCE" value="http://ha.nexdev.net:7704/FPSMiddleService/GetCustomerEvidence" />
    <!--15 minutes-->
  </appSettings>

  <connectionStrings>
