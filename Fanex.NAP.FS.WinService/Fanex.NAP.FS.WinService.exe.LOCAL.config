            providerName="System.Data.SqlClient" />

    <add name="DB.bodb02.bodbAdminNet"
          connectionString="Data Source=10.18.200.215;Initial Catalog=bodb02;integrated security=false; User ID=bodbAdminNet;Password=6j5V1y34hIdqYdsteqX1NGV/P4GjCpXfZMzcr3vS2lE/zxyNEsn/dYjmHcW0HjRr"
