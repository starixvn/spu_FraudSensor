<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="Fanex.MailDelivery.Client" type="Fanex.MailDelivery.Client.Configurations.MailClientSection, Fanex.MailDelivery.Client" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
  </startup>

  <appSettings>
    <add key="ClientSettingsProvider.ServiceUri" value="" />
    <add key="RemoteRefURL" value="tcp://10.40.40.29:8098/CallGetRefFunction" />
    <add key="RemoteCacheUrl" value="tcp://10.40.40.29:8098/CallGetOddsFunction" />
    <add key="queuePath" value="FormatName:DIRECT=TCP:10.40.40.73\private$\fsmessagequeue" />
    <add key="FSUrl" value="tcp://10.40.40.150:8990/UMControllerInterface" />
    <add key="MailingListId" value="82" />
    <add key="ExpiredTime" value="900" />
    <!--15 minutes-->
    <add key="FPS_WEBAPI" value="http://10.2.23.4:8081/api/associatedaccountfraudsensor" />
    <add key="Environment" value="3" />
    <!--1: LOCAL/TEST, 2: UAT, 3: PRO-->
    <add key="FPS_WEBAPI_GET_CUSTOMER_EVIDENCE" value="http://10.2.23.4:885/fps.webapi2.uat/FPSMiddleService/GetCustomerEvidence" />
