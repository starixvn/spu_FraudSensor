<appSettings>
  <clear />
  <add key="webpages:Version" value="3.0.0.0" />
  <add key="webpages:Enabled" value="false" />
  <add key="PreserveLoginUrl" value="true" />
  <add key="ClientValidationEnabled" value="true" />
  <add key="UnobtrusiveJavaScriptEnabled" value="true" />
  <add key="Environment" value="1" />
  <add key="RemoteRefURL" value="tcp://ha.nexdev.net:8888/CallGetRefFunction" />
  <add key="RemoteCacheUrl" value="tcp://ha.nexdev.net:8888/CallGetOddsFunction" />
  <add key="Glimpse:DisableAsyncSupport" value="true" />
  <add key="queuePath" value="FormatName:DIRECT=TCP:10.70.70.242\private$\fdmessagequeue" />
  <add key="SiteId" value="102" />
  <add key="MailGroupId" value="10" />
  <add key="ChunkOfMatchesToScan" value="10" />
  <add key="ClientValidationEnabled" value="true" />
  <add key="FPS_WEBAPI_GET_TOTAL_ASSOCIATION" value="http://ha.nexdev.net:7704/FPSMiddleService/GetCustomerTotalAssociation" />
  <add key="FPS_WEBAPI_GET_ASSOCIATION_ACCOUNT" value="http://ha.nexdev.net:7704/FPSMiddleService/GetCustomerAssociation" />
  <add key="FPS_WEBAPI_GET_CUSTOMER_EVIDENCE" value="http://ha.nexdev.net:7704/FPSMiddleService/GetCustomerEvidence" />
  <add key="MailingListId" value="80" />
  <add key="Log2File" value="true" />
  <add key="Fanex.RemotingRef.Service.Url" value="http://ha.nexdev.net:7258/Main/" />

  <!-- RabbitMQ configuration -->
  <add key="RabbitMQ-Host" value="ha.nexdev.net:5672" />
  <add key="RabbitMQ-VirtualHost" value="/FPS_Oneye_Service" />
  <add key="RabbitMQ-PrefetchCount" value="300" />
  <add key="RabbitMQ-Username" value="fps" />
  <add key="RabbitMQ-Password" value="fps" />
  <add key="RabbitMQ-Port" value="5672" />
  <add key="RabbitMQ-Queue" value="FSQueue" />
  <add key="RabbitMQ-Exchange" value="FSQueue" />
  <add key="RabbitMQ-RoutingKey" value="FSQueue" />
</appSettings>