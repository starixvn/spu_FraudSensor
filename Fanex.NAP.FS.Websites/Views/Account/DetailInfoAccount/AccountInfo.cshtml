@model Fanex.NAP.FS.Library.ViewModels.Account.AccountDetail
@{
    ViewBag.Title = "AccountInfo";
}

<h2 class="title">
    <span class="breadcrumb"><span class="link">Account Search</span><span class="page">Account Detail</span></span>
</h2>

<div class="content-card">
    <div class="status">
        <p class="info"><i class="icon-clean"></i><span>fpsa_pgmthai (12BETTING01123456): This account is clean</span></p>
        <p class="bold">Account Status: <span class="badge-label badge-active">Active</span></p>
        <button class="button btn-add" type="button">Add Evidence</button>
    </div>

    <div class="account-info">
        <div class="info-item">
            <div class="info-title">Login Information</div>
            <div class="control-label">First Login: @Model.AccountInfo.FirstLogin</div>
            <div class="control-label">Last Login: @Model.AccountInfo.LastLogin</div>
            <div class="control-label">Login Frequency: @Model.AccountInfo.FrequencyLogin</div>
        </div>
        <div class="info-item">
            <div class="info-title">Association</div>
            <div class="control-label">Associated Accounts: @Model.AccountInfo.AssociatedAccounts</div>
            <div class="control-label">Associated Devices: @Model.AccountInfo.AssociatedDevices</div>
            <div class="control-label">Shared Devices: @Model.AccountInfo.SharedDevices</div>
            <div class="control-label">No-Shared Devices: @Model.AccountInfo.NoSharedDevices</div>
            <div class="control-label">Account Exceptions: @Model.AccountInfo.AccountExceptions</div>
        </div>
        <div class="info-item">
            <div class="info-title">Fraud Infomation</div>
            <div class="control-label">Evidence: @Model.AccountInfo.Evidence</div>
            <div class="control-label">Problem Account: @Model.AccountInfo.ProblemAccount</div>
            <div class="control-label">Abnormal: @Model.AccountInfo.Abnormal</div>
            <div class="control-label">Dangerous Level: @Model.AccountInfo.DangerousLevel</div>
            <div class="control-label">Auto Suspend: @Model.AccountInfo.AutoSuspend</div>
            <div class="control-label">Commited Fraud Cases: @Model.AccountInfo.CommitedFraudCase</div>
        </div>
    </div>
</div>