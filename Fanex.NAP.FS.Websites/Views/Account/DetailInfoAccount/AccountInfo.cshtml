@model Fanex.NAP.FS.Library.ViewModels.Account.AccountDetail
@{
    ViewBag.Title = "AccountInfo";
}

<h2 class="title">
    <span class="breadcrumb"><span class="link">Account Search</span><span class="page">Account Detail</span></span>
</h2>

<div class="content-card">
    <div class="status">
        <p class="info"><i class="icon-clean"></i><span>fpsa_pgmthai (12BETTING01123456): This account is clean</span></p>
        <p class="bold">Account Status: <span class="badge-label badge-active">Active</span></p>
        <button class="button btn-add" type="button">Add Evidence</button>
    </div>

    <div class="account-info">
        <div class="info-item">
            <div class="info-title">1. Login Information</div>
            <div class="info-text"><label>First Login:</label><span>@Model.AccountInfo.FirstLogin</span></div>
            <div class="info-text"><label>Last Login:</label><span>@Model.AccountInfo.LastLogin</span></div>
            <div class="info-text"><label>Login Frequency:</label><span>@Model.AccountInfo.FrequencyLogin</span></div>           
        </div>
        <div class="info-item">
            <div class="info-title">2. Association</div>
            <div class="info-text"><label>Associated Accounts:</label><span>@Model.AccountInfo.AssociatedAccounts</span></div>
            <div class="info-text"><label>Associated Devices:</label><span>@Model.AccountInfo.AssociatedDevices</span></div>
            <div class="info-text"><label>Shared Devices:</label><span>@Model.AccountInfo.SharedDevices</span></div>
            <div class="info-text"><label>No-Shared Devices:</label><span>@Model.AccountInfo.NoSharedDevices</span></div>
            <div class="info-text"><label>Account Exceptions:</label><span>@Model.AccountInfo.AccountExceptions</span></div>
        </div>
        <div class="info-item">
            <div class="info-title">3. Fraud Infomation</div>
            <div class="info-text"><label>Evidence:</label><span>@Model.AccountInfo.Evidence</span></div>
            <div class="info-text"><label>Problem Account:</label><span>@Model.AccountInfo.ProblemAccount</span></div>
            <div class="info-text"><label>Abnormal:</label><span>@Model.AccountInfo.Abnormal</span></div>
            <div class="info-text"><label>Dangerous Level:</label><span>@Model.AccountInfo.DangerousLevel</span></div>
            <div class="info-text"><label>Auto Suspend:</label><span>@Model.AccountInfo.AutoSuspend</span></div>
            <div class="info-text"><label>Commited Fraud Cases:</label><span>@Model.AccountInfo.CommitedFraudCase</span></div>
        </div>
    </div>
</div>