@model Fanex.NAP.FS.Library.ViewModels.Account.Evidence.RetractedAndExceptionEvidence

<div class="chains-block">
    @if (Model.ChainsDirectedRetractedEvidence != null)
    {
        foreach (var chain in Model.ChainsDirectedRetractedEvidence)
        {
            <div class="chain-row">
                <div class="chain-central">
                    <span>@chain.DirectedUserName</span>
                </div>

                <div class="chain-place">
                    <span class="icon-connect-aa"></span>
                </div>

                <div class="chain-evidence">
                    <span>@chain.EvidenceCode</span>
                </div>
            </div>
        }
    }

    @if (Model.ChainsAffectedRetractedEvidence != null)
    {
        foreach (var chain in Model.ChainsAffectedRetractedEvidence)
        {
            <div class="chain-row">
                <div class="chain-central">
                    <span>@chain.AffectedUserName</span>
                </div>

                <div class="chain-place">
                    <span class="icon-connect-aa"></span>
                </div>

                <div class="chain-central">
                    <span>@chain.DirectedUserName</span>
                </div>

                <div class="chain-place-dashed">
                    <span class="icon-connect"></span>
                </div>

                <div class="chain-evidence-dash">
                    <span>@chain.EvidenceCode</span>
                </div>
            </div>
        }
    }

    @if (Model.ChainsExceptionEvidence != null)
    {
        foreach (var chain in Model.ChainsExceptionEvidence)
        {
            <div class="chain-row">
                <div class="chain-central">
                    <span>@chain.AffectedUserName</span>
                </div>

                <div class="chain-place-slash">
                    <span class="icon-disconnect"></span>
                </div>

                <div class="chain-central">
                    <span>@chain.DirectedUserName</span>
                </div>

                <div class="chain-place-dashed">
                    <span class="icon-connect"></span>
                </div>

                <div class="chain-evidence">
                    <span>@chain.EvidenceCode</span>
                </div>
            </div>
        }
    }
</div>