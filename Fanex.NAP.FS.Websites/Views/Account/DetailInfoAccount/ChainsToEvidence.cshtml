@model Fanex.NAP.FS.Library.ViewModels.Account.Evidence.ChainsToEvidence

<div class="chains-block">
    @if (Model.ChainsDirected != null)
    {
        foreach (var chain in Model.ChainsDirected)
        {
            <div class="chain-row">
                <div class="chain-central">
                    <span>@chain.DirectedUserName</span>
                </div>

                <div class="chain-place-dashed">
                    <span class="icon-connect" node-id="@chain.DirectedAccountId" note-name="@chain.DirectedUserName"></span>
                </div>

                <div class="chain-evidence">
                    <span>@chain.EvidenceCode</span>
                </div>
            </div>
        }
    }

    @if (Model.ChainsAffected != null)
    {
        foreach (var chain in Model.ChainsAffected)
        {
            <div class="chain-row">
                <div class="chain-central">
                    <span>@chain.AffectedUserName</span>
                </div>

                <div class="chain-place">
                    <span class="icon-connect-aa" node-id="@chain.DirectedAccountId" node-name="@chain.DirectedUserName" title="Click to place an Exception"></span>
                </div>

                <div class="chain-central">
                    <span>@chain.DirectedUserName</span>
                </div>

                <div class="chain-place-dashed">
                    <span class="icon-connect"></span>
                </div>

                <div class="chain-evidence">
                    <span>@chain.EvidenceCode</span>
                </div>
            </div>
        }
    }

</div>

@Html.Partial("../Evidence/FormException")