@model Fanex.NAP.FS.Library.ViewModels.Account.Evidence.ChainsToEvidence

<div class="chains-block">
    @foreach (var chain in Model.ChainsRoot)
    {
        <div class="chain-row">
            <div class="chain-central">
                <span>@chain.NodeName</span>
            </div>

            <div class="chain-place-dashed">
                <span class="icon-connect" node-id="@chain.NodeId" note-name="@chain.NodeName"></span>
            </div>

            <div class="chain-evidence">
                <span>@chain.EvidenceName</span>
            </div>
        </div>
    }

    @foreach (var chain in Model.Chains)
    {
        <div class="chain-row">
            <div class="chain-central">
                <span>@chain.NodeNameRoot</span>
            </div>

            <div class="chain-place">
                <span class="icon-connect-aa" node-id="@chain.NodeId" node-name="@chain.NodeName" title="Click to place an Exception"></span>
            </div>

            <div class="chain-central">
                <span>@chain.NodeName</span>
            </div>

            <div class="chain-place-dashed">
                <span class="icon-connect"></span>
            </div>

            <div class="chain-evidence">
                <span>@chain.EvidenceName</span>
            </div>
        </div>
    }
</div>

@Html.Partial("../Evidence/FormException")