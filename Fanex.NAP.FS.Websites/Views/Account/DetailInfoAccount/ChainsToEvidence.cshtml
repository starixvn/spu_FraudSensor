@model Fanex.NAP.FS.Library.ViewModels.Account.Evidence.ChainsToEvidence

<table cellspacing="5" class="table-chains">
    @foreach (var evidence in Model.Evidences)
    {
        <tr class="chain-row">
            <td>
                <div class="chain-central">
                    <a href="#">@evidence.NodeNameRoot</a>
                </div>
            </td>
            <td>
                <div class="chain-place-dashed">
                    <span node-id="@evidence.NodeIdRoot" note-name="@evidence.NodeNameRoot">&nbsp;</span>
                </div>
            </td>
            <td>
                <div class="chain-evidence">
                    <a href="#">@evidence.Evidence.EvidenceName</a>
                </div>
            </td>
        </tr>
    }

    @foreach (var chains in Model.Chains)
    {
        <tr class="chain-row">
            <td>
                <div class="chain-central">
                    <a href="#">@chains.NodeNameParent</a>
                </div>
            </td>
            <td>
                <div class="chain-place">
                    <span node-id ="@chains.NodeIdCurrent" node-name="@chains.NodeNameCurrent">&nbsp;&nbsp;</span>
                </div>
            </td>
            <td>
                <div class="chain-central">
                    <a href="#">@chains.NodeNameCurrent</a>
                </div>
            </td>
            <td>
                <div class="chain-place-dashed">
                    <span>&nbsp;&nbsp;</span>
                </div>
            </td>
            <td>
                <div class="chain-evidence">
                    <a href="#">@chains.Evidence.EvidenceName</a>
                </div>
            </td>
        </tr>
    }

</table>

@Html.Partial("DetailInfoAccount/FormException")