@model Fanex.NAP.FS.Library.ViewModels.Account.Evidence.ChainsToEvidence

<div class="chains-block">
    @foreach (var evidence in Model.Evidences)
    {
        <div class="chain-row">
            <div class="chain-central">
                <span>@evidence.NodeNameRoot</span>
            </div>

            <div class="chain-place-dashed">
                <span class="icon-connect" node-id="@evidence.NodeIdRoot" note-name="@evidence.NodeNameRoot"></span>
            </div>

            <div class="chain-evidence">
                <span>@evidence.Evidence.EvidenceName</span>
            </div>
        </div>
    }

    @foreach (var chains in Model.Chains)
    {
        <div class="chain-row">
            <div class="chain-central">
                <span>@chains.NodeNameParent</span>
            </div>

            <div class="chain-place">
                <span class="icon-connect-aa" node-id="@chains.NodeIdCurrent" node-name="@chains.NodeNameCurrent" title="Click to place an Exception"></span>
            </div>

            <div class="chain-central">
                <span>@chains.NodeNameCurrent</span>
            </div>

            <div class="chain-place-dashed">
                <span class="icon-connect"></span>
            </div>

            <div class="chain-evidence">
                <span>@chains.Evidence.EvidenceName</span>
            </div>
        </div>
    }
</div>

@Html.Partial("DetailInfoAccount/FormException")