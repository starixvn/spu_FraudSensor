@using Fanex.NAP.FS.Library.Models;
@{
    ViewBag.Title = "AccountAssociatedDevice";
}

<div id="device-by-account">
    <div id="device-by-account-filter">
        <div class="filter">
            <div class="form-control">
                <label class="checkbox">
                    <input type="checkbox" id="device-by-account-chk-used-by" checked />
                    <span>Used by </span><span class="device-by-account-username"></span>
                </label>
                <label class="checkbox">
                    <input type="checkbox" id="device-by-account-chk-used-by-account-associated" />
                    <span>1 or more Accounts Away from </span><span class="username-span"></span>
                </label>
            </div>
            <div class="form-control width-150">
                <div class="control-label">Evidence Status</div>
                <select class="control" id="device-by-account-cbb-evidence-status">
                    <option value="@EvidenceStatus.All" selected>All</option>
                    <option value="@EvidenceStatus.Affected">Flagged/Affected</option>                    
                    <option value="@EvidenceStatus.Clean">Clean</option>
                </select>
            </div>
            <div class="form-control" style="vertical-align: bottom;">
                <button class="button btn-search" id="device-by-account-btn-search">Search</button>
            </div>
        </div>        
    </div>
    <div class="table-report" id="device-by-account-content" hidden>
        <table id="device-by-account-table" class="table table-striped" style="width: 100%">
            <thead>
                <tr>
                    <th>Device</th>
                    <th>First Used</th>
                    <th>Latest Used</th>
                    <th></th>
                    <th>Total Uses</th>
                    <th></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>