@using Fanex.NAP.FS.Library.Models;
@{
    ViewBag.Title = "AccountAssociatedAccount";
}

<div id="account-by-account">
    <div id="account-by-account-filter">
        <div class="filter">
            <div class="form-control">
                <label class="checkbox">
                    <input type="checkbox" id="chk-device-away-1" checked />
                    <span>1 Device Away from </span><span class="username-span"></span>
                </label>
                <label class="checkbox">
                    <input type="checkbox" id="chk-device-away-2" />
                    <span>2 or more Device Away from </span><span class="username-span"></span>
                </label>
            </div>

            <div class="form-control">
                <div class="control-label">Status</div>
                <select class="control" id="cbb-status">
                    <option value="@AccountStatus.All" selected>All</option>
                    <option value="@AccountStatus.Active">Active</option>
                    <option value="@AccountStatus.Suspended">Suspended</option>
                    <option value="@AccountStatus.Closed">Close</option>
                </select>
            </div>

            <div class="form-control">
                <div class="control-label">Fraud Status</div>
                <select class="control" id="cbb-fraud-status">
                    <option value="@FraudStatus.All" selected>All</option>
                    <option value="@FraudStatus.Fraud">Fraud</option>
                    <option value="@FraudStatus.Clean">Clean</option>
                </select>
            </div>

            <div class="form-control button-group">
                <button class="button btn-search" id="btn-search-account">Search</button>
            </div>
        </div>
    </div>
    <div id="loading-div" class="report-cont">
        <img src="@Url.Content("~/Content/images/ajax-loader.gif")" alt="Loading ..." />
    </div>
    <div class="table-report" id="account-by-account-content">
        <div class="search-box">
            <span class="icon-magnify"></span>
            <input type="text" class="text" id="account-search" placeholder="Search..." />
        </div>
        <table id="account-by-account-table" class="table table-striped" style="width: 100%">
            <thead>
                <tr>
                    <th>Account</th>
                    <th>Status</th>
                    <th>First Login</th>
                    <th>Lastest Login</th>
                    <th></th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>