@{
    ViewBag.Title = "AccountAssociatedAccount";
}

<div id="account-by-account">
    <div id="account-by-account-filter">
        <div class="filter">
            <div class="form-control width-300">
                <label class="checkbox">
                    <input type="checkbox" id="chk-device-away-1" />
                    <span>1 Device Away from</span><span class="username-span"></span>
                </label>
            </div>
            <div class="form-control width-150">
                <div class="control-label">Status</div>
                <select class="control" id="cbb-status">
                    <option value="0" selected>All</option>
                    <option value="1">Suspended</option>
                    <option value="2">Close</option>
                </select>
            </div>
            <div class="form-control">
                <span>Search </span>
                <input type="text" class="text" id="account-search" />
            </div>
        </div>

        <div class="filter">
            <div class="form-control width-300">
                <label class="checkbox">
                    <input type="checkbox" id="chk-device-away-2" />
                    <span>2 or more Device Away from </span><span class="username-span"></span>
                </label>
            </div>
            <div class="form-control width-150">
                <div class="control-label">Fraud Status</div>
                <select class="control" id="cbb-fraud-status">
                    <option value="0" selected>All</option>
                    <option value="1">Flagged</option>
                    <option value="2">Indirect Flagged</option>
                    <option value="3">Clean</option>
                </select>
            </div>
            <div class="form-control button-group">               
                <button class="button btn-search" id="btn-search">Search</button>
            </div>
           
        </div>        
    </div>
    <div id="account-by-account-content">
        <table id="acount-by-account-table" class="table table-striped" style="width: 100%">
            <thead>
                <tr>
                    <th>Account</th>
                    <th>Status</th>
                    <th>First Login</th>
                    <th>Lastest Login</th>
                    <th></th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>