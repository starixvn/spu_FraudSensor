@model Fanex.NAP.FS.Library.ViewModels.Account.AccountDetail
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles{
    <link href="~/Content/scss/pages/account/account.css" rel="stylesheet" />
    <link href="~/Content/scss/pages/evidence/evidence.css" rel="stylesheet" />
}

@Html.Partial("DetailInfoAccount/AccountInfo", Model)

<div class="content-card">
    <div class="status">
        <p class="info" style="margin-bottom: 0">
            <span class="expand-all" title="Expand All"></span>
            <span class="collapse-all" title="Collapse All"></span>
            Account Detail
        </p>
    </div>

    <div id="associated_report" class="ui-accordion ui-widget ui-helper-reset ui-accordion-icons">
        <div class="report-item">
            <h3 class="head ui-accordion-header ui-helper-reset ui-state-default ui-corner-all" ref="chains_evidence">
                <span class="ui-icon ui-icon-triangle-1-e"></span>
                <a href="#">
                    Chains To Evidence                   
                </a>
            </h3>
            <div id="chains_evidence" class="report-cont" hidden>
                <img src="@Url.Content("~/Content/images/ajax-loader.gif")" alt="Loading ..." />
            </div>
        </div>

        <div class="report-item">
            <h3 class="head ui-accordion-header ui-helper-reset ui-state-default ui-corner-all" ref="retract_evidence">
                <span class="ui-icon ui-icon-triangle-1-e"></span>
                <a href="#">
                    Retracted Evidence And Exceptions                   
                </a>
            </h3>
            <div id="retract_evidence" class="report-cont" hidden>
                <img src="@Url.Content("~/Content/images/ajax-loader.gif")" alt="Loading ..." />
            </div>
        </div>

        <div class="report-item">
            <h3 class="head ui-accordion-header ui-helper-reset ui-state-default ui-corner-all" ref="associated_account">
                <span class="ui-icon ui-icon-triangle-1-e"></span>
                <a href="#">
                    Associated Accounts                    
                </a>
            </h3>
            <div id="associated_account" class="report-cont" hidden>
                <img src="@Url.Content("~/Content/images/ajax-loader.gif")" alt="Loading ..." />
            </div>
        </div>

        <div class="report-item">
            <h3 class="head ui-accordion-header ui-helper-reset ui-state-default ui-corner-all" ref="associated_device">
                <span class="ui-icon ui-icon-triangle-1-e"></span>
                <a href="#">
                    Associated Devices      
                </a>
            </h3>
            <div id="associated_device" class="report-cont" hidden>
                <img src="@Url.Content("~/Content/images/ajax-loader.gif")" alt="Loading ..." />
            </div>
        </div>

        <div class="report-item">
            <h3 class="head ui-accordion-header ui-helper-reset ui-state-default ui-corner-all" ref="transaction_history">
                <span class="ui-icon ui-icon-triangle-1-e"></span>
                <a href="#">
                    Transaction History               
                </a>
            </h3>
            <div id="transaction_history" class="report-cont" hidden>
                <img src="@Url.Content("~/Content/images/ajax-loader.gif")" alt="Loading ..." />
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script type="text/javascript">
        var ACCOUNTID = '@Model.AccountInfo.Id';
        var CUSTID = '@Model.AccountInfo.CustId';
        var USERNAME = '@Model.AccountInfo.UserName';
    </script>

    @Scripts.Render("~/evidence-scripts"
                    , "~/account-scripts"
                    , "~/account/associated-scripts"
                    , "~/transaction/history-scripts")
}