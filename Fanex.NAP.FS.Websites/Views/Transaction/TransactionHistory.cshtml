@{
    ViewBag.Title = "TransactionHistory";
}

<div id="transaction-history">
    <div id="transaction-history-filter">
        <div class="filter">
            <div class="form-control width-150">
                <div class="control-label">Report Length</div>
                <select class="control" id="cbb-fraud-status">
                    <option value="24hours" selected>Last 24 hours</option>
                    <option value="7days">Last 7 days</option>
                    <option value="30days">Last 30 days</option>
                    <option value="180days">Last 180 days</option>
                </select>
            </div>
            <div class="form-control button-group">
                <button class="button btn-search" id="btn-search-transaction">Search</button>
            </div>
        </div>
    </div>

    <div id="transaction-history-content" hidden>
        <table id="transaction-history-table" class="table table-striped" style="width: 100%">
            <thead>
                <tr>
                    <th>Date/Time</th>
                    <th>Device</th>
                    <th>Robot Tracking</th>
                    <th>Action</th>
                    <th>Action Result</th>
                    <th>Device Type</th>
                    <th>Browser</th>
                    <th>Domain</th>
                    <th>IP Address</th>
                    <th>Country</th>
                    <th>Region</th>
                    <th>City</th>
                    <th>Service Provider</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>