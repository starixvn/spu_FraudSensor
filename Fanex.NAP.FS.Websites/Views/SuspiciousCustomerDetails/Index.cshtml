@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles{
    @Styles.Render("~/suspicious-customer-styles")
}

<h1 class="title">Suspicious Customer/Customer details</h1>
<div class="customer-details">
    <div class="customer-info">
        Customer: S312C02A6333(CNY)
        <span class="m-x-12">-</span> Date Range: 11/01/2017 ~ 03/13/2018
    </div>
    <h2 class="sub-title">Follow-Up Details</h2>
    <div class="block form-filter">
        <div class="group">
            <label class="text text-assignees">Assignees</label>
            <select class="control">
                <option value="0">None Selected</option>
            </select>
        </div>

        <button class="button -primary">Save</button>
        <button class="button -cancel">Cancel</button>
    </div>
    <div class="block">
        <h2 class="sub-title">Fraud Cases</h2>
        <table class="table table-striped -fraud-case">
            <thead>
                <tr>
                    <th>Case</th>
                    <th>Violations</th>
                    <th>Verified</th>
                    <th>Unverified</th>
                    <th>Last Verified Date</th>
                    <th>Last Verified By</th>
                    <th>Verify All</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>CS_test</td>
                    <td class="text-center">4</td>
                    <td class="text-center">0</td>
                    <td class="text-center">0</td>
                    <td>-</td>
                    <td>-</td>
                    <td class="text-center"><a href="#">Verify</a></td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="block">
        <h2 class="sub-title">Logs/Notes</h2>
        <table class="table table-striped -logs-notes">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Description</th>
                    <th>Author</th>
                    <th>Type</th>
                    <th>Remove</th>
                </tr>
            </thead>
            <tbody> 
                <tr>
                    <td class="text-center" colspan="5">There is no data</td>
                </tr>
            </tbody>
        </table>
        <div class="add-component">
            <input type="text" class="text" placeholder="Input your notes here..." />
            <button class="button -primary">Add</button>
        </div>
    </div>
    <div class="block suspicious-customers">        
        <label class="checkbox">
            <input type="checkbox" checked />
            <span>Delinquency</span>
        </label>
        <label class="checkbox">
            <input type="checkbox" />
            <span>Dirty Account</span>
        </label>
        <label class="checkbox">
            <input type="checkbox" />
            <span>Hedge Account</span>
            <span class="icon-help-circle"></span>
        </label>
    </div>
    <div class="block">
        <h2 class="sub-title">Daily Violated Tickets</h2>
        <table class="table table-striped width-100per">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Trans Date</th>
                    <th>Bet ID</th>
                    <th>Bet Type</th>
                    <th>Choice</th>
                    <th>Result</th>
                    <th>Odds</th>
                    <th>Stake</th>
                    <th>Winloss</th>
                    <th>Status</th>
                    <th>IP</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="text-center" colspan="11">There is no data</td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="block statistic">
        <h2 class="sub-title">Win Loss Statistic</h2>
        <div class="win-loss">
            <div>
                <div class="top-header">
                    <h2>Summary</h2>
                </div>
                <table class="table table-striped width-100per">
                    <thead>
                        <tr>
                            <th>Turnover</th>
                            <th>Win Loss</th>
                            <th>Margin (%)</th>
                            <th>Bet Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="text-right">13,801,300.00</td>
                            <td class="text-right text-red">-602,555.50</td>
                            <td class="text-right text-red">-4.36</td>
                            <td class="text-right">546</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div>
                <div class="top-header">
                    <h2>Event Choice</h2>
                </div>
                <table class="table table-striped width-100per">
                    <thead>
                        <tr>
                            <th>Sport</th>
                            <th>Turnover</th>
                            <th>Win Loss</th>
                            <th>Margin (%)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Live</td>
                            <td class="text-right">12,116,500.00</td>
                            <td class="text-right text-red">-645,659.00</td>
                            <td class="text-right text-red">-5.32</td>
                        </tr>
                        <tr>
                            <td>None-live</td>
                            <td class="text-right">1,684,800.00</td>
                            <td class="text-right">43,103.50</td>
                            <td class="text-right">2.55</td>
                        </tr>
                    </tbody>
                </table>
            </div>            
        </div>
        <div class="win-loss">
            <div>
                <div class="top-header">
                    <h2>Top 5 sports by margin (%)</h2>
                </div>
                <table class="table table-striped width-100per">
                    <thead>
                        <tr>
                            <th>Sport</th>
                            <th>Turnover</th>
                            <th>Win Loss</th>
                            <th>Margin (%)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Soccer</td>
                            <td class="text-right">12,116,500.00</td>
                            <td class="text-right text-red">-645,659.00</td>
                            <td class="text-right text-red">-5.32</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div>
                <div class="top-header">
                    <h2>Top 5 bet types by margin (%)</h2>
                </div>
                <table class="table table-striped width-100per">
                    <thead>
                        <tr>
                            <th>Sport</th>
                            <th>Turnover</th>
                            <th>Win Loss</th>
                            <th>Margin (%)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Handicap</td>
                            <td class="text-right">5,918,900.00</td>
                            <td class="text-right">978,263.50</td>
                            <td class="text-right">16.52</td>
                        </tr>
                        <tr>
                            <td>Over/Under</td>
                            <td class="text-right">7,882,400.00</td>
                            <td class="text-right text-red">-1,580,819.00</td>
                            <td class="text-right text-red">-20.05</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>