@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles{
    @Styles.Render("~/suspicious-customer-styles")
}

<h1 class="title">Suspicious Customer/Customer details</h1>
<div class="customer-details">
    <div class="customer-info">
        Customer: S312C02A6333(CNY)
        <span class="m-x-12">-</span> Date Range: 11/01/2017 ~ 03/13/2018
    </div>

    <h2 class="sub-title">Follow-Up Details</h2>

    <div class="block form-filter">
        <div class="group">
            <label class="text text-assignees">Assignees</label>
            <select class="control">
                <option value="0">None Selected</option>
            </select>
        </div>

        <button class="button -primary">Save</button>
        <button class="button -cancel">Cancel</button>
    </div>

    <div class="block">
        <h2 class="sub-title">Fraud Cases</h2>
        <table class="table table-striped -fraud-case">
            <thead>
                <tr>
                    <th>Case</th>
                    <th>Violations</th>
                    <th>Verified</th>
                    <th>Unverified</th>
                    <th>Last Verified Date</th>
                    <th>Last Verified By</th>
                    <th>Verify All</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>CS_test</td>
                    <td class="text-center">4</td>
                    <td class="text-center">0</td>
                    <td class="text-center">0</td>
                    <td>-</td>
                    <td>-</td>
                    <td class="text-center"><a href="#">Verify</a></td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="block">
        <h2 class="sub-title">Logs/Notes</h2>
        <table class="table table-striped -logs-notes">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Description</th>
                    <th>Author</th>
                    <th>Type</th>
                    <th>Remove</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="text-center" colspan="5">There is no data</td>
                </tr>
            </tbody>
        </table>
        <div class="add-component">
            <input type="text" class="text" placeholder="Input your notes here..." />
            <button class="button -primary">Add</button>
        </div>
    </div>

    <div class="block suspicious-customers">
        <label class="checkbox">
            <input type="checkbox" checked />
            <span>Delinquency</span>
        </label>
        <label class="checkbox">
            <input type="checkbox" />
            <span>Dirty Account</span>
        </label>
        <label class="checkbox">
            <input type="checkbox" />
            <span>Hedge Account</span>
            <span class="icon-help-circle"></span>
        </label>
    </div>

    <div class="block">
        <h2 class="sub-title">Daily Violated Tickets</h2>
        <table class="table table-striped width-100per" id="violated-tickets">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Trans Date</th>
                    <th>Bet ID</th>
                    <th>Bet Type</th>
                    <th>Choice</th>
                    <th>Result</th>
                    <th>Odds</th>
                    <th>Stake</th>
                    <th>Winloss</th>
                    <th>Status</th>
                    <th>IP</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>

    <div class="block statistic">
        <h2 class="sub-title">Win Loss Statistic</h2>

        <div class="win-loss">
            <div>
                <div class="top-header">
                    <h2>Summary</h2>
                </div>
                <table class="table table-striped width-100per" id="summary">
                    <thead>
                        <tr>
                            <th>Turnover</th>
                            <th>Win Loss</th>
                            <th>Margin (%)</th>
                            <th>#Tickets</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
            <div>
                <div class="top-header">
                    <h2>Event Choice</h2>
                </div>
                <table class="table table-striped width-100per" id="choice">
                    <thead>
                        <tr>
                            <th>Choice</th>
                            <th>Turnover</th>
                            <th>Win Loss</th>
                            <th>Margin (%)</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="win-loss">
            <div>
                <div class="top-header">
                    <h2>Top 5 sports by margin (%)</h2>
                </div>
                <table class="table table-striped width-100per" id="top-5-sport">
                    <thead>
                        <tr>
                            <th>Sport</th>
                            <th>Turnover</th>
                            <th>Win Loss</th>
                            <th>Margin (%)</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>

            <div>
                <div class="top-header">
                    <h2>Top 5 bet types by margin (%)</h2>
                </div>
                <table class="table table-striped width-100per" id="top-5-bettype">
                    <thead>
                        <tr>
                            <th>Bet type</th>
                            <th>Turnover</th>
                            <th>Win Loss</th>
                            <th>Margin (%)</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
        var custid = 1;
        var username = "";
        var from = "2010/8/12";
        var to = "2010/8/12";
    </script>

    @Scripts.Render("~/suspicious-customer-scripts")    
}