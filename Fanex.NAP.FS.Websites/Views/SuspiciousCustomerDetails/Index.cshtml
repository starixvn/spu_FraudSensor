@model Fanex.NAP.FS.Library.ViewModels.SuspiciousCustomerDetails.CustomerDetailsViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var delinquency = Model.CustInfo.IsDelinquent.HasValue && Model.CustInfo.IsDelinquent.Value;
    var dirty = Model.CustInfo.IsDirty.HasValue && Model.CustInfo.IsDirty.Value;
    var hedge = Model.CustInfo.IsHedge.HasValue && Model.CustInfo.IsHedge.Value;
}

@section styles{
    @Styles.Render("~/Contents/CoreBetList")
    @Styles.Render("~/suspicious-customer-styles")
}

<h1 class="title">Suspicious Customer Details</h1>
<div class="customer-details">
    <div class="customer-info">
        Customer: @Model.Username (@Model.Currency)
    </div>

    <div class="area -1">
        <h2 class="sub-title">Follow-Up Details</h2>

        <div class="area-content">
            <div class="form-filter">
                <div class="group">
                    <label class="text text-assignees">Assignees</label>
                    <select class="control">
                    </select>
                </div>

                <button class="button -primary" disabled id="save-btn">Save</button>
            </div>

            <h2 class="sub-title">Fraud Cases</h2>
            <table class="table table-striped -fraud-case" id="fraudcase">
                <thead>
                    <tr>
                        <th>Case</th>
                        <th>Violations</th>
                        <th>Verified</th>
                        <th>Unverified</th>
                        <th>Last Verified Date</th>
                        <th>Last Verified By</th>
                        <th>Verify All</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>

            <h2 class="sub-title">Logs/Notes</h2>
            <table class="table table-striped -logs-notes" id="log-note">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Description</th>
                        <th>Author</th>
                        <th>Type</th>
                        <th>Remove</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
            
            <div class="add-component">
                <input type="text" class="text" placeholder="Input your note here..." id="note"/>
                <button class="button -primary" id="add-btn">Add</button>
            </div>

            <ul class="suspicious-customers account-type">
                <li class="customer-type">
                    <label class="checkbox">
                    <input type="checkbox" @(delinquency ? "checked":"") id="delinquency"/>
                        <span>Delinquency</span>
                    </label>
                </li>
                <li class="customer-type">
                    <label class="checkbox">
                    <input type="checkbox" @(dirty ? "checked" : "") id="dirty"/>
                        <span>Dirty Account</span>
                    </label>
                </li>
                <li class="customer-type">
                    <label class="checkbox">
                    <input type="checkbox" @(hedge ? "checked" : "") id="hedge"/>
                        <span>Hedge Account</span>                        
                    </label>
                </li>                
            </ul>
        </div>
    </div>

    <div class="area -2">
        <h2>Win Loss Summary - Data Range: @Model.FromDate.ToString("MMM dd, yyyy") - @Model.ToDate.ToString("MMM dd, yyyy")</h2>
        <div class="area-content">
            <h2 class="sub-title">Daily Violated Tickets</h2>
            <table class="table table-striped width-100per" id="violated-tickets">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Trans Date</th>
                        <th>Bet ID</th>
                        <th>Choice</th>
                        <th>Result</th>
                        <th>Odds</th>
                        <th>Stake</th>
                        <th>Winloss</th>
                        <th>Status</th>
                        <th>IP</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>

            <h2 class="sub-title">Win Loss Statistic</h2>

            <div class="win-loss">
                <div class="col">
                    <div class="top-header">
                        <h2>Summary</h2>
                    </div>
                    <table class="table table-striped width-100per" id="summary">
                        <thead>
                            <tr>
                                <th>Month</th>
                                <th>Turnover</th>
                                <th>Win Loss</th>
                                <th>Margin (%)</th>
                                <th>#Tickets</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>


                    <div class="top-header">
                        <h2>Event Choice</h2>
                    </div>
                    <table class="table table-striped width-100per" id="choice">
                        <thead>
                            <tr>
                                <th>Live/Non-Live</th>
                                <th>Turnover</th>
                                <th>Win Loss</th>
                                <th>Margin (%)</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

                <div class="col">
                    <div class="top-header">
                        <h2>Top 5 sports by margin (%)</h2>
                    </div>
                    <table class="table table-striped width-100per" id="top-5-sport">
                        <thead>
                            <tr>
                                <th>Sport</th>
                                <th>Turnover</th>
                                <th>Win Loss</th>
                                <th>Margin (%)</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>

                    <div class="top-header">
                        <h2>Top 5 bet types by margin (%)</h2>
                    </div>
                    <table class="table table-striped width-100per" id="top-5-bettype">
                        <thead>
                            <tr>
                                <th>Bet type</th>
                                <th>Turnover</th>
                                <th>Win Loss</th>
                                <th>Margin (%)</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
        var generalParam =
            {
                custId: @Model.CustInfo.CustId,
                from: "@Model.FromDate.ToString()",
                to: "@Model.ToDate.ToString()"
            }

        console.log("@Model.Assignee")

        var assignee = "@(string.IsNullOrEmpty(Model.Assignee) ? "None" : Model.Assignee)";
    </script>

    @Scripts.Render("~/suspicious-customer-scripts")
}