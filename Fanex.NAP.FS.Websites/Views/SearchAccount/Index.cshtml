@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="title">Search Account</h1>

@section styles{
    <link href="~/Content/scss/MultipleSelect/jquery.multiselect.filter.css" rel="stylesheet" />
    <link href="~/Content/scss/MultipleSelect/jquery.multiselect.css" rel="stylesheet" />
    <link href="~/Content/scss/pages/account/account.css" rel="stylesheet" />
}

<div class="filter">
    <div class="form-control">
        <div class="control-label">Subscribers</div>
        <select id="ddlSubscriber" multiple="multiple"></select>
        <div id="caption-error-subscribers" class="caption-error">
            <span style="color:red"></span>
        </div>
    </div>
    <div class="form-control">
        <div class="control-label">Account</div>
        <input type="text" id="account" class="control input-field" value=@ViewBag.KeySearch />

        <div id="caption-error-account" class="caption-error">
            <span style="color:red"></span>
        </div>
    </div>
    <div class="form-control button-group">
        <button class="button btn-search" id="btnSearch">Search</button>
    </div>
</div>

<div class="grid-content header-content">
    <span>No.</span>
    <span>Subscriber</span>
    <span>Username</span>
    <span>Username2</span>
</div>

