@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="title">Account Search</h1>

@section styles{
    <link href="~/Content/scss/MultipleSelect/jquery.multiselect.filter.css" rel="stylesheet" />
    <link href="~/Content/scss/MultipleSelect/jquery.multiselect.css" rel="stylesheet" />
    <link href="~/Content/scss/pages/account/account.css" rel="stylesheet" />
}

<fieldset class="fieldset-search">
    <legend>Search Information</legend>
    <div class="filter">
        <div class="form-control">
            <div class="control-label">Subscribers</div>
            <select id="ddlSubscriber" multiple="multiple"></select>
        </div>
    </div>

    <div class="filter">
        <div class="form-control">
            <div class="control-label">Account</div>
            <input type="text" id="account" class="control input-field" value=@ViewBag.KeySearch />

            <div id="caption-error" class="caption-error">
                <span style="color:red"></span>
            </div>
        </div>
        <div class="form-control button-group">
            <button class="button btn-search" id="btnSearch">Search</button>
        </div>
    </div>
</fieldset>

<div class="content-account">
    <table id="table-account" class="table table-striped" style="width: 100%">
        <thead>
            <tr>
                <th>No.</th>
                <th>Subscriber</th>
                <th>Username1</th>
                <th>Username2</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

@section scripts{
    <script src="~/Scripts/MultipleSelect/jquery.multiselect.filter.js"></script>
    <script src="~/Scripts/MultipleSelect/jquery.multiselect.js"></script>

    @Scripts.Render("~/scripts/search-account")
}