@model Fanex.NAP.FS.Library.ViewModels.SubscriberAccount.Evidence.ChainsToEvidence

<table cellspacing="5" class="table-chains">
    @foreach (var chains in Model.Evidences)
    {
        <tr class="chain-row">
            <td>
                <div class="chain-central">
                    <a href="#">@chains.NodeRoot</a>
                </div>
            </td>
            <td>
                <div class="chain-place">
                    <span>&nbsp;</span>
                </div>
            </td>
            <td>
                <div class="chain-evidence">
                    <a href="#">@chains.Evidence.EvidenceName</a>
                </div>
            </td>
        </tr>
    }

    @foreach (var chains in Model.Chains)
    {
        <tr class="chain-row">
            <td>
                <div class="chain-central">
                    <a href="#">@chains.NodeParent</a>
                </div>
            </td>
            <td>
                <div class="chain-place">
                    <span>&nbsp;&nbsp;</span>
                </div>
            </td>
            <td>
                <div class="chain-central">
                    <a href="#">@chains.NodeCurrent</a>
                </div>
            </td>
            <td>
                <div class="chain-place-dashed">
                    <span>&nbsp;&nbsp;</span>
                </div>
            </td>
            <td>
                <div class="chain-evidence">
                    <a href="#">@chains.Evidence.EvidenceName</a>
                </div>
            </td>
        </tr>
    }

</table>

<script type="text/javascript">    
    chains_to_evidence();
</script>

@Html.Partial("Detail/FormException")