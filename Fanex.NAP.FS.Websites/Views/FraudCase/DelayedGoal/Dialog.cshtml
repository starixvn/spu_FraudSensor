<div class="customer-list" id="customer-list" title="Delay Goal Customer List">
    <div class="top-header-in-popup">
        <div class="add-component">
            <input type="text" class="text" id="username">
            <button class="button -primary" id="add-user-btn">Add</button>
        </div>
        <div class="search-export">
            <div class="search-box">
                <input type="text" class="text" id="username-search">
                <span class="icon-magnify icon-search"></span>
            </div>
            <span class="icon-export-excel" id="export-excel" style="cursor:pointer"></span>
        </div>
    </div>

    <table id="delayed-goal-customer-list" class="table table-striped width-100per" style="width: 100%">
        <thead>
            <tr>
                <th class="col-no">#</th>
                <th>Customer</th>
                <th>Added By</th>
                <th class="col-added-date">Added Date</th>
                <th class="col-delete ">Delete</th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>