<div class="internal-account-list" id="internal-account-list" title="Excluded Members List">   
    <div class="top-header-in-popup">
        <div class="info-left">
            <label style="margin-right:5px">User Name </label>
            <div class="add-component">                
                <input type="text" class="text" id="username" />
                <button class="button -primary" id="add-account-btn">Add</button>                
            </div>
            <button class="button -export" id="export-excel-account"><span class="icon-export-excel"></span>Export</button>
        </div>
        <div class="search-box">
            <input type="text" class="text" id="username-search" />
            <span class="icon-magnify icon-search"></span>
        </div>
    </div>

    <table id="internal-account-table" class="table table-striped width-100per" style="width: 100%">
        <thead>
            <tr>
                <th class="col-no">#</th>
                <th>User Name</th>
                <th>Level</th>
                <th>Currency</th>                
                <th class="col-delete ">Remove</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>