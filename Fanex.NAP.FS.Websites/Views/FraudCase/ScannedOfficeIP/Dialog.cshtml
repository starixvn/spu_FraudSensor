<div class="customer-list" id="ip-list" title="IP List">
    <div class="form-filter">
        <div class="group">
            <label class="text">From</label>
            <input type="text" class="control" id="from-ip">
        </div>

        <div class="group">
            <label class="text">To</label>
            <input type="text" class="control" id="to-ip" />
        </div>

        <button class="button -primary" id="add-ip-btn">Add</button>

        <button class="button -export" id="export-excel"><span class="icon-export-excel"></span>Export</button>
    </div>

    <table id="ip-table" class="table table-striped width-100per" style="width: 100%">
        <thead>
            <tr>
                <th class="col-no">#</th>
                <th>From IP</th>
                <th>To IP</th>
                <th class="col-delete ">Delete</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>