<div id="form-evidence" style="display:none;">
    <div class="modal-dialog">
        <div class="box">
            <div class="box-heading">Account Information</div>
            <div class="box-content">
                <div><label>Account:</label><span> sml</span></div>
                <div><label>Subscriber:</label><span> FPS</span></div>
            </div>
        </div>

        <div class="grid-7">
            <div class="box box-3">
                <div class="box-heading">Evidence List</div>
                <div class="box-content">
                    <div class="search-box">
                        <span class="icon-magnify"></span>
                        <input type="text" class="text" id="" placeholder="Search here..." />
                    </div>
                    <div class="group">
                        <div class="group-heading">Monitoring</div>
                        <div class="group-content">
                            <div class="item"><span>1.1 VIP Smart Punter</span></div>
                            <div class="item"><span>1.2 Smart Punter</span></div>
                            <div class="item"><span>1.3 8RM Accounts</span></div>
                            <div class="item"><span>1.4 VIP Monitors Accounts</span></div>
                            <div class="item"><span>1.5 Dangers</span></div>
                        </div>
                    </div>
                    <div class="group">
                        <div class="group-heading">Soccer Fraud</div>
                        <div class="group-content">
                            <div class="item"><span>2.1 Abnormal Betting- Other Bettypes</span></div>
                            <div class="item"><span>2.2 Goal Delay-Provider</span></div>
                            <div class="item"><span>2.3 MBC Abnormal Group 2</span></div>
                            <div class="item"><span>2.4 Licensee Both side Betting</span></div>
                        </div>
                    </div>

                    <div class="modify">
                        <span>To modify Evidence List,</span>
                        <span class="link">click here</span>
                    </div>
                </div>
            </div>

            <div class="box box-center"> 
                <div class="box-content">
                    <button class="button -add" type="button" id="btn-add" style="width: 100%;">Add</button>
                    <button class="button -add" type="button" id="btn-remove" style="width: 100%; margin-top:10px;">Remove</button>
                </div>              
            </div>

            <div class="box box-3">
                <div class="box-heading">Added Evidence</div>
                <div class="box-content"></div>
            </div>
        </div>

        <div class="box">
            <div class="box-heading">Comment</div>
            <div class="box-content">
                <textarea rows="3" class="comment-field" id="comment"></textarea>
            </div>
        </div>

        <div class="modal-footer margin-top-10">
            <button class="button btn-cancel-outline" id="btn-cancel-evidence">Cancel</button>
            <button class="button -add" id="btn-submit-evidence">Submit</button>
        </div>
    </div>
</div>