<div id="form-exception" style="display:none;">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="chains-block">
                <span>Exception: </span>
                <div class="chain-row">
                    <div class="chain-central-add">
                        <a style="color: #396EF8;" href="#" id="node-root"></a>
                    </div>
                    <div class="chain-place-slash">
                        <span class="icon-disconnect"></span>
                    </div>
                    <div class="chain-central-add">
                        <a style="color: #396EF8;" href="#" id="node-exception"></a>
                    </div>
                </div>
            </div>
            <div style="margin-bottom: 10px;"><span id="note-caption"></span></div>
            <div style="margin-bottom: 5px;">
                <span>Comment: </span>
                <div class="form-control">
                    <textarea rows="5" class="comment-field" id="comment"></textarea>
                </div>
            </div>
        </div>

        <div class="modal-footer">
            <button class="button btn-cancel-outline" id="btn-cancel-exception">Cancel</button>
            <button class="button -add" id="btn-add-exception">Add Exception</button>
        </div>
    </div>
</div>