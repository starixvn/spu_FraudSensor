<div id="form-retract-evidence" style="display:none;">
    <div class="modal-dialog">
        <div class="modal-content">
            <span>Comment: </span>
            <div class="form-control" style="margin-bottom: 24px;">
                <textarea rows="5" class="comment-field" id="retract-evidence-comment"></textarea>
            </div>
        </div>

        <div class="modal-footer">
            <button class="button btn-cancel-outline" id="retract-evidence-btn-cancel">Cancel</button>
            <button class="button -add" id="retract-evidence-btn-retract">Retract Evidence</button>
        </div>
    </div>
</div>

<div id="retract-evidence-confirmation" style="display:none;">
    <div class="modal-dialog">
        <div class="modal-content" id="retract-evidence-confirmation-message" style="margin-bottom: 24px;">
        </div>
        <div class="modal-footer">
            <button class="button btn-cancel-outline" id="retract-evidence-confirmation-btn-cancel">Cancel</button>
            <button class="button -add" id="retract-evidence-confirmation-btn-ok">Ok</button>
        </div>
    </div>
</div>