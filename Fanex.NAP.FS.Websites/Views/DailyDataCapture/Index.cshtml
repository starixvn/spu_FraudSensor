
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles{
    <link href="~/Content/scss/pages/daily-data-capture/daily-data-capture.css" rel="stylesheet" />
}

<h1 class="title">DAILY DATA MONITOR</h1>

<div class="form-filter">
    <div class="group calendar">
        <div class="div-switch">
            <label class="label-switch" id="lblSwitchScannedDate">Scanned Date</label>
            <label class="switch">
                <input type="checkbox" id="inputScannedDate" checked />
                <span class="slider round"></span>
            </label>
        </div>
        
        <input type="text" id="from-date" class="control">
        <span class="icon-calendar-text"></span>
    </div>

    <div class="group calendar">
        <input type="text" id="to-date" class="control">
        <span class="icon-calendar-text"></span>
    </div>

    <button class="button -primary" id="generate">Generate</button>
    <button class="button -export" id="export"><span class="icon-export-excel"></span>Export</button>
</div>

<table id="match-table" class="table table-striped width-100per" style="width: 100%">
    <thead>
        <tr>
            <th>MatchId</th>
            <th>Match</th>
            <th>Event Date</th>
            <th>Scanned Date</th>
            <th>Company TO <br /> Old/<span class="new-value">New</span></th>
            <th>Super TO <br /> Old/<span class="new-value">New</span></th>
            <th>Master TO <br /> Old/<span class="new-value">New</span></th>
            <th>Agent TO <br /> Old/<span class="new-value">New</span></th>
            <th>#Tickets <br /> Old/<span class="new-value">New</span></th>
            <th>#Settled Tickets <br /> Old/<span class="new-value">New</span></th>
            <th>#Canceled Tickets <br /> Old/<span class="new-value">New</span></th>
            <th>Note</th>            
        </tr>
    </thead>
    <tbody></tbody>
</table>

@section scripts{
    @Scripts.Render("~/daily-data-capture-scripts")    
}
