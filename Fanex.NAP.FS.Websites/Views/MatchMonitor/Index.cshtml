@using Fanex.NAP.FS.Websites.ViewModels.MatchMonitor

@{
    ViewBag.Title = "MATCH MONITOR";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="title">Match Monitor</h1>
<div class="form-filter">
    <div class="group calendar">
        <label class="text">Event Date</label>
        <input type="text" class="control" value="@DateTime.Today.ToString("yyyy-MM-dd")">
        <span class="icon-calendar-text"></span>
    </div>
    <div class="group width-160">
        <label class="text">Sport</label>
        <select class="control" id="sport">
            <option value="1">Soccer</option>
        </select>
    </div>
    <div class="group width-400">
        <label class="text">League</label>
        <select class="control" id="league">
        </select>
    </div>
    <div class="group width-160">
        <label class="text" id="is_verified">Verified</label>
        <select class="control">
            <option>All</option>
            <option value="1">Yes</option>
            <option value="0">No</option>
        </select>
    </div>
    <div class="group width-160">
        <label class="text">Match Status</label>
        <select class="control" id="match_status">
            <option>All</option>
            <option value="running">In-Play</option>
            <option value="completed">Completed</option>
        </select>
    </div>
    <div class="group">
        <label class="checkbox">
            <input type="checkbox" id="is_main_market"/>
            <span>Main Markets Only</span>
        </label>
    </div>
    <button class="button -primary">Generate</button>
    <button class="button -export"><span class="icon-export-excel"></span>Export</button>
</div>

<div class="top-header">
    <div class="refresh">
        <select class="refresh-option">
            <option>Not refresh</option>
        </select>
        <div class="refresh-action">
            <button class="icon"><span class="icon-autorenew"></span></button>
            <span class="number">45</span>
        </div>
    </div>
</div>

<table class="table table-striped width-100per">
    <thead>
        <tr>
            <th class="col-no">#</th>
            <th class="col-verified">Verified</th>
            <th>Last Verified By</th>
            <th>Event</th>
            <th>Score</th>
            <th class="col-status">Status</th>
            <th class="col-bsng">BSNG</th>
            <th class="col-flagged-acc">Flagged Acc</th>
            <th class="col-delay-goal">Delay Goal</th>
            <th>Note</th>
        </tr>
    </thead>
