@{
    ViewBag.Title = "MATCH MONITOR";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>@ViewBag.Title</h2>

<div class="row">
    <div class="form-group col-sm-3">
        <label for="event_date">Event Date</label>
        <input type="date" id="event_date" class="form-control" />
    </div>

    <div class="form-group col-sm-3">
        <label for="sport">Sport</label>
        <select class="form-control" id="sport">
            <option>Soccer</option>
        </select>
    </div>

    <div class="form-group col-sm-3">
        <label for="league">League</label>
        <select class="form-control" id="league">
            <option>All League</option>
        </select>
    </div>
</div>

<div class="row">
    <div class="form-group col-sm-3">
        <label for="is_verified">Verified</label>
        <select id="is_verified" class="form-control">
            <option>Yes</option>
            <option>No</option>
        </select>
    </div>

    <div class="form-group col-sm-3">
        <label for="match_status">Match Status</label>
        <select class="form-control" id="match_status">
            <option>In-play</option>
        </select>
    </div>

    <div class="form-group col-sm-2">
        <input type="checkbox" id="is_main_market" />
        <label for="is_main_market">
            Main Markets Only
        </label>
    </div>

    <button class="col-sm-1 btn btn-success" id="generate">Generate</button>
    <div class="col-sm-1"></div>
    <button class="col-sm-1 btn btn-primary" id="export">Export</button>
</div>

@section scripts{
    @Scripts.Render("~/match-monitor")
}

