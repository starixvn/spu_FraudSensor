@using Fanex.NAP.FS.Websites.ViewModels.MatchMonitor
@model Fanex.NAP.FS.Websites.Models.MatchMonitor.BalanceUpDate

@{
    ViewBag.Title = "MATCH MONITOR";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="title">Match Monitor</h1>
<div class="form-filter">
    <div class="group calendar">
        <label class="text">Event Date</label>
        <input type="text" id="event_date" class="control" value="@DateTime.Today.ToString("yyyy-MM-dd")">
        <span class="icon-calendar-text"></span>
    </div>
    <div class="group width-160">
        <label class="text">Sport</label>
        <select class="control" id="sport">
            <option value="1">Soccer</option>
        </select>
    </div>
    <div class="group width-400">
        <label class="text">League</label>
        <select class="control" id="league">
        </select>
    </div>
    <div class="group width-160">
        <label class="text">Verified</label>
        <select class="control" id="is_verified">
            <option>All</option>
            <option value="true">Yes</option>
            <option value="false" selected>No</option>
        </select>
    </div>
    <div class="group width-160">
        <label class="text">Match Status</label>
        <select class="control" id="match_status">
            <option>All</option>
            <option value="running" selected>In-Play</option>
            <option value="completed">Completed</option>
        </select>
    </div>
    <div class="group">
        <label class="checkbox">
            <input type="checkbox" checked id="is_main_market"/>
            <span>Main Markets Only</span>
        </label>
    </div>
    <button class="button -primary" id="generate">Generate</button>
    <button class="button -export" id="export"><span class="icon-export-excel"></span>Export</button>
</div>

<div id="match_grid" hidden>
    <div class="top-header">
        <div class="refresh">
            <select class="refresh-option" id="refresh_interval">
                <option value="--">Not refresh</option>
                <option value="10">10s</option>
                <option value="20">20s</option>
                <option value="60">1m</option>
                <option value="300">5m</option>
            </select>
            <div class="refresh-action">
                <span class="number" id="refresh_countdown">-</span>
            </div>
        </div>
    </div>

    <table class="table table-striped width-100per">
        <thead>
            <tr>
                <th class="col-no">#</th>
                <th class="col-verified">Verified</th>
                <th>Last Verified By</th>
                <th>Event</th>
                <th>Score</th>
                <th class="col-status">Status</th>
                <th hidden id="start"></th>
                <th hidden id="end"></th>
                @*<th>Note</th>*@
            </tr>
        </thead>
        <tbody>
            @*<tr>
                    <td class="text-center">1</td>
                    <td class="text-center">
                        <label class="checkbox">
                            <input type="checkbox" />
                            <span></span>
                        </label>
                    </td>
                    <td>
                        Tracy
                    </td>
                    <td>
                        <span class="team-home">U23 Vietnam</span> vs <span class="team-away">U23 Quatar</span>
                        <div class="league-name">AFC U23 Championship</div>
                    </td>
                    <td class="text-center">0-0</td>
                    <td class="text-center">In-Play</td>
                    <td class="has-icon text-center"><span class="icon-check"></span></td>
                    <td class="has-icon text-center"><span class="icon-check"></span></td>
                    <td class="has-icon text-center"><span class="icon-close"></span></td>
                    @*<td class="col-note">
                        <div class="note">
                            <input type="text" class="input-note" value="Tracy: need to report this case">
                            <span class="icon-dots-horizontal-circle icon-note"></span>
                        </div>
                    </td>
                </tr>*@
        </tbody>
    </table>
    <div class="pagination">
        <div class="page-size">
            <span>Page size</span>
            <select class="size" id="pager">
                <option>50</option>
                <option>100</option>
                <option>200</option>
            </select>
            <ul class="pages">
                <li class="page-prev disabled" style="margin-top: 3%"><a id="back" href="#">Back</a></li>
                <li>
                    <select id="page_index">
                    </select>
                </li>
                <li class="page-next" style="margin-top: 3%"><a id="next" href="#">Next</a></li>
            </ul>
        </div>
        <span id="table_summary"></span>
    </div>
</div>

@section scripts{
    <script>
        var columns = @Html.Raw(Match.Columns);

        var balanceUpDay = new Date(@Model.BalanceUpDay.Year, @Model.BalanceUpDay.Month, @Model.BalanceUpDay.Day);
    </script>
    @Scripts.Render("~/match-monitor")
}

