@using Fanex.NAP.FS.Library.Models;
@using Fanex.NAP.FS.Library.Models.MatchMonitor.FraudCaseDetails;
@model Fanex.NAP.FS.Library.ViewModels.MatchMonitor.FraudCaseDetails.MatchFraudCaseInfo

@{
    ViewBag.Title = "FRAUD CASE DETAILS";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles{
    @Styles.Render("~/fraud-case-styles")
    @Styles.Render("~/Contents/CoreBetList")            
    <link href="~/Content/jquery-ui-timepicker-addon.min.css" rel="stylesheet" />
    <link href="~/Content/scss/MultipleSelect/jquery.multiselect.css" rel="stylesheet" />    

    <style>
        /*div.dataTables_wrapper {
            width: 1870px;
            margin: 0 auto;
        }*/
    </style>
}

<h1 class="title">@ViewBag.Title</h1>

<table class="fraud-case-details">
    <tr>
        <td class="info-name">Event</td>
        <td class="info-value">@Html.Raw(Model.Event)</td>
        <td class="info-name">Fraud case</td>
        <td class="info-value">@Model.FraudCase</td>
    </tr>
    <tr>
        <td class="info-name">Date</td>
        <td class="info-value">@Model.EventDate.ToString("MMM dd, yyyy")</td>
        <td class="info-name">HT/FT Score</td>
        <td class="info-value">@Model.HTScore / @Model.FTScore</td>
    </tr>
</table>

<div class="form-filter">
    <div class="group width-160">
        <label class="text">Market</label>
        <div class="edit-field col_9">
            <select class="control" id="market">
                <option value="-1" selected>All</option>
                <option value="0">Non-Live</option>
                <option value="1">Live</option>
            </select>
        </div>
    </div>
    <div class="group width-160">
        <label class="text">Currency</label>
        <div class="edit-field col_9">
            <select class="control" id="currency"></select>
        </div>
    </div>
    <div class="group width-300">
        <label class="text">Evidence</label>        
        <div class="edit-field col_9">
            <select id="ddlEvidence" multiple="multiple">
                @foreach (var item in (IEnumerable<Evidence>)ViewBag.EvidenceList)
                {
                    <option value="@item.EvidenceCode">@item.EvidenceName</option>
                }
            </select>
        </div>
    </div>
</div>
<div class="form-filter">
    <div class="group">
        <label class="text">Trans Date</label>
        <div class="edit-field col_9">
            <input type="text" id="transDateFrom" class="form-control date-time-picker" value="@String.Format("{0:MMM dd, yyyy HH:mm:ss}", Model.EventDate)">
        </div>
    </div>
    <div class="group">
        <div class="edit-field col_9">
            <input type="text" id="transDateTo" class="form-control date-time-picker" value="@String.Format("{0:MMM dd, yyyy HH:mm:ss}", Model.EventDate)">
        </div>        
    </div>
    <div class="group">
        <label class="text">HDP/Score</label>    
        <div class="edit-field col_9">
            <select class="control" id="scoreHDP"></select>
        </div>
    </div>
    <button class="button -primary" id="generate">Generate</button>
</div>

<div id="detailTabs">
    <ul>
        <li><a href="#ticket-tab" id="tickets">By Ticket</a></li>
        <li><a href="#customer-tab" id="customers">By Customers</a></li>
    </ul>

    <button class="button -export export-in-tabs"><span class="icon-export-excel"></span>Export</button>

    @Html.Partial("FraudCaseDetails/TicketDetails", Model)

    @Html.Partial("FraudCaseDetails/CustomerDetails")
</div>

@section scripts{    
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/jquery-ui-1.12.1.min.js"></script>
    <script src="~/Scripts/jquery-ui-timepicker-addon.min.js"></script>   
    <script src="~/Scripts/MultipleSelect/jquery.multiselect.js"></script> 
    <script>
        var parameters =
            {
                fraudCaseId: @Model.FraudCaseId,
                matchId: @Model.MatchId,
                eventDate: '@Model.EventDate.ToShortDateString()'
            };

        var bu_date = "@ViewBag.BUDate.ToString("MMM dd, yyyy")";

        var isArbitrage = @(Convert.ToInt32((FraudCaseId)Model.FraudCaseId == FraudCaseId.Arbitrage));

        //datetime picker
        $(".date-time-picker").datetimepicker({
            dateFormat: 'M dd, yy',
            timeFormat: 'HH:mm:ss',
            stepHour: 2,
            stepMinute: 10,
            stepSecond: 10
        });

        jQuery.validator.methods.date = function (value, element) {
            var isChrome = /Chrome/.test(navigator.userAgent) && /Google Inc/.test(navigator.vendor);
            if (isChrome) {
                var d = new Date();
                return this.optional(element) || !/Invalid|NaN/.test(new Date(d.toLocaleDateString(value)));
            } else {
                return this.optional(element) || !/Invalid|NaN/.test(new Date(value));
            }
        };
                
    </script>

    @Scripts.Render("~/scripts/match-monitor/fraud-case-details")    
}