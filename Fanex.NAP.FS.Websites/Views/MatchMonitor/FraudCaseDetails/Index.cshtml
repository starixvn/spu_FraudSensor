@model Fanex.NAP.FS.Library.ViewModels.MatchMonitor.FraudCaseDetails.MatchFraudCaseInfo

@{
    ViewBag.Title = "FRAUD CASE DETAILS";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles{
    @Styles.Render("~/fraud-case-styles")
    @Styles.Render("~/Contents/CoreBetList")
    <style>
        #ticket-tab .match, #ticket-tab .league {
            display: none;
        }

        #tickets-last-7-days .match span:nth-child(2n+1) {
            color: #01122B;
            font-weight: bold !important;
        }

        #tickets-last-7-days .leagueName {
            color: #3c96c7;
            font-weight: bold;
        }

        .ui-button-icon-only.demo-splitbutton-select {
            width: 1em
        }

        .ip-link {
            cursor: pointer;
        }
    </style>
}

<h1 class="title">@ViewBag.Title</h1>

<div class="info fraud-case-details">
    <div class="row">
        <div class="info-name">Event</div>
        <div class="info-value">@Html.Raw(Model.Event)</div>
        <div class="info-name">Fraud case</div>
        <div class="info-value">@Model.FraudCase</div>
    </div>
    <div class="row">
        <div class="info-name">Date</div>
        <div class="info-value">@Model.EventDate.ToString("MMM dd, yyyy")</div>
        <div class="info-name">HT/FT Score</div>
        <div class="info-value">@Model.HTScore / @Model.FTScore</div>
    </div>
</div>

<div id="detailTabs">
    <ul>
        <li><a href="#ticket-tab" id="tickets">By Ticket</a></li>
        <li><a href="#customer-tab" id="customers">By Customers</a></li>
    </ul>

    <button class="button -export export-in-tabs"><span class="icon-export-excel"></span>Export</button>

    @Html.Partial("FraudCaseDetails/TicketDetails")

    @Html.Partial("FraudCaseDetails/CustomerDetails")
</div>

@section scripts{
    <script>
        var parameters =
            {
                fraudCaseId: @Model.FraudCaseId,
                matchId: @Model.MatchId,
                eventDate: '@Model.EventDate.ToShortDateString()'
            };

        var bu_date = "@ViewBag.BUDate.ToString("MMM dd, yyyy")";
    </script>

    @Scripts.Render("~/scripts/match-monitor/fraud-case-details")
}