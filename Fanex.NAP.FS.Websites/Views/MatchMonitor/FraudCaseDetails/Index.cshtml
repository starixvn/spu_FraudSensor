@model Fanex.NAP.FS.Library.ViewModels.MatchMonitor.FraudCaseDetails.MatchFraudCaseInfo

@{
    ViewBag.Title = "FRAUD CASE DETAILS";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles{
    @Styles.Render("~/fraud-case-styles")
    @Styles.Render("~/Contents/CoreBetList")
}

<h1 class="title">@ViewBag.Title</h1>

<table class="fraud-case-details">
    <tr>
        <td class="info-name">Event</td>
        <td class="info-value">@Html.Raw(Model.Event)</td>
        <td class="info-name">Fraud case</td>
        <td class="info-value">@Model.FraudCase</td>
    </tr>
    <tr>
        <td class="info-name">Date</td>
        <td class="info-value">@Model.EventDate.ToString("MMM dd, yyyy")</td>
        <td class="info-name">HT/FT Score</td>
        <td class="info-value">@Model.HTScore / @Model.FTScore</td>
    </tr>
</table>

<div id="detailTabs">
    <ul>
        <li><a href="#ticket-tab" id="tickets">By Ticket</a></li>
        <li><a href="#customer-tab" id="customers">By Customers</a></li>
    </ul>

    <button class="button -export export-in-tabs"><span class="icon-export-excel"></span>Export</button>

    @Html.Partial("FraudCaseDetails/TicketDetails")

    @Html.Partial("FraudCaseDetails/CustomerDetails")
</div>

@section scripts{
    <script>
        var parameters =
            {
                fraudCaseId: @Model.FraudCaseId,
                matchId: @Model.MatchId,
                eventDate: '@Model.EventDate.ToShortDateString()'
            };

        var bu_date = "@ViewBag.BUDate.ToString("MMM dd, yyyy")";
    </script>

    @Scripts.Render("~/scripts/match-monitor/fraud-case-details")
}