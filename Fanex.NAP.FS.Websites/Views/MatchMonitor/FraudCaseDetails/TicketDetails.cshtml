@using Fanex.NAP.FS.Library.Models
@model Fanex.NAP.FS.Library.ViewModels.MatchMonitor.FraudCaseDetails.MatchFraudCaseInfo

@switch ((FraudCaseId)Model.FraudCaseId)
{
    case Fanex.NAP.FS.Library.Models.FraudCaseId.Arbitrage:
        <div id="ticket-tab">
            <table class="table table-striped width-100per display nowrap" style="width: 100%">
                <thead>
                    <tr>
                        <th rowspan="2">Member</th>
                        <th rowspan="2">Evidence</th>
                        <th rowspan="2">Dangerous <br />  Level</th>
                        <th rowspan="2">Currency</th>
                        <th rowspan="2">Bet ID</th>
                        <th rowspan="2">Odds</th>
                        <th colspan="3">Stake (RM)</th>
                        <th rowspan="2">Trans Date</th>
                        <th rowspan="2"></th>
                        <th rowspan="2">Member</th>
                        <th rowspan="2">Evidence</th>
                        <th rowspan="2">Dangerous <br /> Level</th>
                        <th rowspan="2">Currency</th>
                        <th rowspan="2">Bet ID</th>
                        <th rowspan="2">Odds</th>
                        <th colspan="3">Stake (RM)</th>
                        <th rowspan="2">Trans Date</th>
                    </tr>
                    <tr>
                        <th>Virtual</th>
                        <th>Com.PT</th>
                        <th>Full</th>
                        <th>Virtual</th>
                        <th>Com.PT</th>
                        <th>Full</th>
                    </tr>
                </thead>
            </table>
        </div>
        break;
    default:
        <div id="ticket-tab">
            <table class="table table-striped width-100per" style="width: 100%">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Member</th>
                        <th>Currency</th>
                        <th>Trans Date</th>
                        <th>Bet ID</th>
                        <th>Choice</th>
                        <th>Score</th>
                        <th>Odds</th>
                        <th>Stake</th>
                        <th>Win Loss</th>
                        <th>Status</th>
                        <th>IP</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <div id="ticket-by-ip">
            @Html.Partial("FraudCaseDetails/TicketByIP")
        </div>
        break;
}
