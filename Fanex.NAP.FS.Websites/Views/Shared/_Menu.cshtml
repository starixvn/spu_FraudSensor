@using System.Collections.Generic;
@using Fanex.NAP.Core.Models;
@model IList<MenuItem>

@{
    Func<string, string> iconLookup = menuName =>
    {
        switch (menuName)
        {
            case "Account & Device Search":
                return "<span class='icon icon-account-device'></span>";
            case "Suspicious Bets":
                return "<span class='icon icon-warning'></span>";
            case "Reports":
                return "<span class='icon icon-chart-scatterplot-hexbin'></span>";
            case "Configurations":
                return "<span class='icon icon-settings'></span>";
            case "Association":
                return "<span class='icon icon-settings'></span>";
            case "Notification":
                return "<span class='icon icon-email'></span>";
            case "Settings":
                return "<span class='icon icon-email'></span>";
            default:
                return string.Empty;
        }
    };

    var controllerBaseType = ViewBag.ActiveMenu as string;
}

<ul class="main-menu">
    @foreach (var menu in Model.Where(m => m.Parent == null && m.IsActive && m.Name != "Home").OrderBy(m => m.DisplayOrder))
    {
        var subMenus = Model.Where(m => m.Parent != null && m.IsActive && m.Parent.Id == menu.Id).OrderBy(m => m.DisplayOrder);

        <li class="menu-item" id="@menu.Name">
            <a href="#@menu.Name" class="link @(subMenus.Any()? "has-child" : "") @(controllerBaseType.Contains(menu.Name) ? "active" : "")">@Html.Raw(iconLookup(menu.Name)) @menu.Name</a>
            @if (subMenus.Any())
            {
            <ul class="sub-menu">
                @foreach (var subMenu in subMenus)
                {
                    <li class="sub-menu-item">
                        <a href="@Url.Content(subMenu.ValidUrl)" class="link">@subMenu.Name</a>
                    </li>
                }
            </ul>
            }
        </li>
    }
</ul>