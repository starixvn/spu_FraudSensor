@using Fanex.NAP.Core.Configuration
<!doctype html>
<html lang="en">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Fraud Sensor</title>
    <link href="https://fonts.googleapis.com/css?family=Lato:400,400i,700" rel="stylesheet">
    <link href="~/Content/scss/fonts/Fraud-Sensor/style.css" rel="stylesheet" />
    @Styles.Render("~/Content/styles")
    @RenderSection("styles", false)
    @Scripts.Render("~/bundles/modernizr")
    <style>
        #notificationContainer {
            background-color: #fff;
            border: 1px solid rgba(100, 100, 100, .4);
            -webkit-box-shadow: 0 3px 8px rgba(0, 0, 0, .25);
            overflow: visible;
            position: absolute;
            top: 40px;
            right: -119px;
            width: 400px;
            z-index: -1;
            display: none;
        }

        #notificationContainer:before {
            content: '';
            display: block;
            position: absolute;
            width: 0;
            height: 0;
            color: transparent;
            border: 10px solid black;
            border-color: transparent transparent white;
            margin-top: -20px;
            margin-left: 230px;
        }

        #notificationsBody {
            padding: -233px 0px 0px 0px !important;
            min-height: 70px;
            max-height: 633px;
            overflow-y: auto;
            margin-top: -20px;
            color: black;
        }

        #notification_count {
            padding: 3px 7px 3px 7px;
            background: #cc0000;
            color: #ffffff;
            font-weight: bold;
            margin-left: 77px;
            border-radius: 9px;
            position: absolute;
            margin-top: -11px;
            font-size: 11px;
        }

        hr.style-two {
            border: 0;
            height: 1px;
            background-image: linear-gradient(to right, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.75), rgba(0, 0, 0, 0));
            margin-bottom: 10px !important;
            margin-top: 10px !important;
        }

        .notify-content-wrap {
            margin: 5px 5px 5px 5px;
        }

        .notifications {
            overflow-y: auto;
        }

        .notify-text-wrap {
            line-height: 0.5em;
            height: 1.5em;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
            width: 100%;
            padding: 8px;
        }

        .notify-text-bold {
            font-weight: bold;
        }

        .notify-text-time {
            text-decoration: wavy;
            color: #808080;
        }

        .notify-text-nomsg {
            color: #FF0000 !important;
        }


        .user-notify-wrap {
            float: right;
            display: inline-block;
            position: relative;
        }

        .user-notify {
            background: url(img/bell.png) no-repeat 10px center transparent;
            border: 0px;
            cursor: pointer;
            padding: 29px 10px 3px 30px;
            margin: 5px 22px 0px 5px;
        }

        .badge.up {
            top: 2px;
            border-radius: 15px;
            left: 30px;
        }

        .badge-danger {
            color: #fff;
            background-color: #f44336;
        }

        .badge {
            padding: 3px 6px;
            position: absolute;
        }

        .notify-pointer {
            cursor: pointer;
        }
    </style>
</head>
<body>
    <header class="header">
        <a href="@Url.Action("Index", "Home")" class="logo">
            <svg width="183" height="32">
                <image xlink:href="~/Content/scss/images/logo.svg" src="~/Content/scss/images/logo.png" width="183" height="32" alt="Fraud Sensor" />
            </svg>
        </a>
        <div id="notification-icon" class="icon-bell icon-announcement">
            <div class="user-notify"></div>
            <span id="noti-unread-msg" class="badge badge-danger up"></span>
            <div id="notificationContainer">
                <div id="notificationsBody" class="notifications"></div>
            </div>
        </div>
        <div class="header-right">
            @Html.Action("Menu", "Home",new { activeMenu = ViewContext.Controller.GetType().BaseType.Name } )
            @Html.Partial("_LoginPartial")
        </div>
    </header>
    <section class="wrapper">
        <div class="content">
            @RenderBody()
        </div>
    </section>

    <div id="loading">
        <div class="ui-widget-overlay ui-front"></div>
        <div class="loader"></div>
    </div>

    <div id="confirmation" title="Confirmation"></div>
    <div id="success" style="color: #4f971f" class="text-center"></div>
    <div id="error" style="color:red" class="text-center"></div>
    @Scripts.Render("~/bundles/jquery")
    @if (NapSettings.Settings.EnableReCheckIn)
    {
        <script src="~/Areas/UserLogin/scripts/ReCheckIn.js" type="text/javascript"></script>
    }
    @Scripts.Render("~/core")
    @Scripts.Render("~/notification")
    @RenderSection("scripts", required: false)
</body>
</html>