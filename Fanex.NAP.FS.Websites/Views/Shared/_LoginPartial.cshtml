@using Microsoft.AspNet.Identity
<div class="login-info">
    <span class="icon-bell icon-announcement"></span>
    <div class="username">
        @User.Identity.GetUserName()
        <ul class="sub-menu">
            <li class="sub-menu-item">
                <a href="~/UserLogin/Login/Logout" class="link"><span class="icon icon-logout"></span>Log out</a>
            </li>
        </ul>
    </div>
</div>