@using Microsoft.AspNet.Identity
<div class="header-info">
    <div class="search-component">
        <span class="icon-magnify" id="button-search"></span>
        <input type="text" class="search-text" id="txt-search" value=@ViewBag.KeySearch />
        <div class="search-option" id="search-option" item-key="search-account">
            Search account
            <ul class="sub-menu">
                <li class="sub-menu-item">
                    <a href="#" class="link" id="link-item" item-key="search-device">Search device</a>
                </li>
            </ul>
        </div>
    </div>
    <div class="username">
        @User.Identity.GetUserName()
        <ul class="sub-menu -small">
            <li class="sub-menu-item">
                <a href="#" class="link">Change Password</a>
            </li>
            <li class="sub-menu-item">
                <a href="~/UserLogin/Login/Logout" class="link">Log Out</a>
            </li>
        </ul>
    </div>
</div>

<script src="~/Scripts/search.js"></script>